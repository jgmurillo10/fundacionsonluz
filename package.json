{
  "name": "fundacion-son-luz",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "gsap": "3.14.2",
    "iron-session": "9.0.1",
    "lucide-react": "0.468.0",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint app components lib tests scripts cloudflare/worker.ts next.config.ts",
    "cms:dev": "wrangler dev --ip 127.0.0.1",
    "cms:setup": "node scripts/setup-local-cms.mjs",
    "cms:smoke": "node --env-file=.env.local scripts/smoke-local-cms.mjs",
    "cms:migrate:local": "wrangler d1 migrations apply sonluz-blog --local",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write app components lib tests scripts cloudflare/worker.ts wrangler.jsonc next.config.ts tsconfig.json eslint.config.mjs package.json README.md .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.1",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-dropcursor": "3.32.0",
    "@tiptap/extension-floating-menu": "3.32.0",
    "@tiptap/extension-gapcursor": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-list-keymap": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "vite": "7.3.7"
  },
  "keywords": [
    "fundacion",
    "nextjs",
    "son-luz"
  ],
  "license": "MIT",
  "homepage": "https://fundacionsonluz.com"
}
