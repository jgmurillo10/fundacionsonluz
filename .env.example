NEXT_PUBLIC_SITE_URL=https://fundacionsonluz.com
# Optional LOCAL editorial sandbox. Cannot enable it in production.
SONLUZ_LOCAL_PREVIEW=0

# Server-only CMS settings. Generate LOCAL values with npm run cms:setup.
# Leave blank until configured. Never use NEXT_PUBLIC_ for these settings.
SONLUZ_CMS_URL=
SONLUZ_WORKER_SECRET=
SONLUZ_ADMIN_EMAIL=juanchomurcas@gmail.com
SONLUZ_ADMIN_PASSWORD_HASH=
# Optional JSON array of {"email":"...","passwordHash":"salt:hash"}.
# Each additional admin needs their own credentials. Never expose this to the client.
SONLUZ_ADDITIONAL_ADMINS=[]
SONLUZ_SESSION_SECRET=

# Cloudflare Analytics Engine: disabled by default and outside the production domain.
# Enable in both Next.js and the Worker only at the approved rollout.
SONLUZ_ANALYTICS_ENABLED=0
